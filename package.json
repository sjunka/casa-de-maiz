{
  "name": "CasaMaiz",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "e2e:mock-server": "node e2e/mock-server.js",
    "e2e:build:ios": "ENVFILE=.env.e2e.ios npx react-native run-ios",
    "e2e:build:android": "ENVFILE=.env.e2e.android npx react-native run-android",
    "e2e:ios": "maestro test -e APP_ID=org.reactjs.native.example.CasaMaiz e2e/flows",
    "e2e:android": "maestro test -e APP_ID=com.casamaiz e2e/flows"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@sentry/react-native": "^8.20.0",
    "@tanstack/react-query": "^5.101.4",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-config": "^1.6.1",
    "react-native-device-info": "^15.0.2",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.26.2",
