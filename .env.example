API_BASE_URL=https://payload-cms-poc-seven.vercel.app

# Optional local overrides for feature flags, e.g. "enable_new_home=false,show_reorder=true"
FEATURE_FLAG_OVERRIDES=

# Set to "true" to send formBlock submissions to the shared API. Mocked locally otherwise.
ENABLE_LIVE_FORM_SUBMISSIONS=

# Sentry DSN for crash reporting. Left blank, crash reporting stays disabled (local dev default).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
